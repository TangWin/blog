{
  "name": "ink-blog",
  "version": "1.0.0",
  "description": "Minimalist bilingual blog template powered by Astro",
  "type": "module",
  "homepage": "https://github.com/OldJii/ink-blog",
  "repository": {
    "type": "git",
    "url": "https://github.com/OldJii/ink-blog.git"
  },
  "author": "Folay",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run tsc && astro check && astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "tsc": "tsc --noEmit",
    "lint": "npm run tsc && astro check",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,astro}\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-satteri": "^0.2.2",
    "@astrojs/mdx": "^6.0.2",
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "^10.0.1",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.8.4",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.4.4",
    "astro-expressive-code": "^0.42.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.21",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "i18next": "^26.3.1",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reading-time": "^1.5.0",
    "rehype-figure": "^1.0.1",
    "rehype-katex": "^7.0.1",
    "remark-block-containers": "^1.1.0",
    "remark-code-import": "^1.2.0",
    "remark-gemoji": "^8.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "unist-util-visit": "^5.1.0",
    "vite-plugin-svgr": "^5.2.0",
    "yet-another-react-lightbox": "^3.32.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-angular": "^19.5.0",
    "@pagefind/default-ui": "^1.5.2",
    "eslint": "^10.4.1",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "postcss-import": "^16.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sanitize-html": "^2.14.0"
  }
}
