---
import siteConfig from '~@/site.config';
import type { ThemeOptions } from '@/typings/config';
import ThemeSelect from '@/components/theme-select';
import SocialLinks from '@/components/social-links';
import type { SupportedLang } from '@/helpers/i18n-utils';

interface Props {
  copyright?: string;
  lang?: SupportedLang;
}

const { copyright = siteConfig.footer?.copyright, lang = 'zh' } = Astro.props;
void lang;
---

<footer class="mt-auto pt-16">
  <div class="border-t border-slate3 py-6">
    <div class="flex items-center justify-between text-[13px] text-slate8">
      <div class="flex items-center gap-4">
        {!!siteConfig.socialLinks && <SocialLinks client:visible />}
        <span>{copyright}</span>
      </div>
      <div class="flex items-center gap-3">
        {(siteConfig.theme as ThemeOptions).enableUserChange && <ThemeSelect client:visible />}
      </div>
    </div>
  </div>
</footer>
