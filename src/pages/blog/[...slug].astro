---
import dayjs from 'dayjs';
import { getCollection, render } from 'astro:content';
import i18next from '@/i18n';
import { setLang } from '@/i18n';
import PageLayout from '@/components/layouts/PageLayout.astro';
import ArticleJsonLd from '@/components/json-ld/article.astro';
import AffixTitle from '@/components/affix-title';
import Toc from '@/components/toc';
import CodeGroupEvent from '@/components/code-group-event';
import ImageLightbox from '@/components/ImageLightbox';
import siteConfig from '~@/site.config';
import { getFullTitle } from '@/helpers/utils';
import { localePath } from '@/helpers/i18n-utils';
import Giscus from '@/components/comments/Giscus';
import 'remark-block-containers/css';
import '@/assets/style/blog.css';

const lang = 'zh';
setLang(lang);

export async function getStaticPaths() {
  const postEntries = await getCollection('post-zh', ({ data }) => {
    return import.meta.env.DEV || data.draft !== true;
  });

  return postEntries.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await render(post);
const lastModifiedDate = dayjs(
  remarkPluginFrontmatter.lastModified
    ? remarkPluginFrontmatter.lastModified
    : undefined,
);
const lastModified = lastModifiedDate.format('DD/MM/YYYY');
const pubDate = dayjs(post.data.pubDate);
const formattedPubDate = pubDate.format('DD/MM/YYYY');
// 构建时由 scripts/export-md.mjs 生成，见 dist/md/
const markdownUrl = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}md/${post.id}.md`;
---

<PageLayout 
  title={post.data.title} 
  description={post.data.description || siteConfig.description}
  contentWidth={post.data.contentWidth}
  lang={lang}
>
  <ArticleJsonLd
    slot="json-ld"
    title={getFullTitle(post.data.title)}
    description={post.data.description || siteConfig.description}
    pubDate={post.data.pubDate!}
    lastModified={lastModifiedDate.toDate()}
  />
  <CodeGroupEvent client:only="react" />
  <AffixTitle title={post.data.title} offsetTop={100} homePath={localePath("/", "zh")} client:idle />

  <div slot="header">
    <a id="back" href={localePath("/", "zh")} class="inline-flex items-center gap-1.5 text-sm text-slate9 transition-colors hover:text-slate12 cursor-pointer mb-12">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
      {i18next.t('nav.back') || '返回'}
    </a>
  </div>

  <div class="blog-content">
    <div class="mb-12">
      <h1 class="!mb-4">{post.data.title}</h1>
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[13px] text-slate9 tabular-nums">
        <time>{formattedPubDate}</time>
        {!!siteConfig.readTime && <span class="text-slate6">·</span>}
        {
          siteConfig.readTime && (
            <span>
              {i18next.t('blog.readingTime', {
                minutes: remarkPluginFrontmatter.minutesRead,
              })}
            </span>
          )
        }
        {
          post.data.tags && post.data.tags.length > 0 && (
            <>
              <span class="text-slate6">·</span>
              {
                post.data.tags.map((tag) => (
                  <a 
                    href={localePath(`/tags/${tag}`, lang)}
                    class="text-slate9 transition-colors hover:text-slate12"
                  >
                    #{tag}
                  </a>
                ))
              }
            </>
          )
        }
        <span class="text-slate6">·</span>
        <a
          href={markdownUrl}
          class="text-slate9 transition-colors hover:text-slate12"
          title="纯 Markdown 版本，图表为图片、链接为绝对地址，可直接粘贴到掘金、知乎等编辑器"
          data-pagefind-ignore
        >
          Markdown 原文
        </a>
      </div>
    </div>
    <ImageLightbox client:only="react">
      <Content />
    </ImageLightbox>
    {
      siteConfig.lastModified && (
        <div class="mt-12 border-t border-slate4 pt-4 text-sm text-slate9">
          {i18next.t('blog.lastModified')} {lastModified}
        </div>
      )
    }
    {
      siteConfig.giscus && (
        <Giscus 
          client:only="react"
          config={{
            repo: siteConfig.giscus.repo,
            repoId: siteConfig.giscus.repoId,
            category: siteConfig.giscus.category,
            categoryId: siteConfig.giscus.categoryId,
            mapping: siteConfig.giscus.mapping || 'pathname',
            strict: siteConfig.giscus.strict,
            reactionsEnabled: siteConfig.giscus.reactionsEnabled,
            inputPosition: siteConfig.giscus.inputPosition || 'bottom',
            lang: 'zh-CN',
          }}
          theme={siteConfig.theme?.mode === 'auto' ? 'auto' : siteConfig.theme?.mode}
        />
      )
    }
  </div>
  <Toc
    className="fixed top-0 right-0 bottom-0 hidden w-64 xl:block"
    listClassName="px-5 pt-44 pb-14 "
    dataSource={headings}
    client:visible
  />
</PageLayout>

<script>
  import Heti from 'heti/js/heti-addon.js';

  const heti = new Heti('.blog-content');
  heti.autoSpacing();

  // Load Mermaid only on pages that actually contain diagrams.
  // Post content sits inside a client:only React island (ImageLightbox), so the
  // .mermaid blocks are only in the DOM after hydration: watch for them.
  const PENDING = '.mermaid:not([data-processed])';
  let mermaidPromise: Promise<typeof import('mermaid').default> | undefined;
  let busy = false;
  const loadMermaid = () =>
    (mermaidPromise ??= import('mermaid').then(({ default: mermaid }) => {
      mermaid.initialize({
        startOnLoad: false,
        theme: 'neutral',
        look: 'handDrawn',
        securityLevel: 'loose',
        fontFamily: 'monospace',
        fontSize: 14,
        flowchart: { useMaxWidth: true, htmlLabels: true },
      });
      return mermaid;
    }));
  const renderMermaid = async () => {
    if (busy || !document.querySelector(PENDING)) return;
    busy = true;
    try {
      const mermaid = await loadMermaid();
      await mermaid.run({ querySelector: PENDING });
    } catch (err) {
      console.error('[mermaid]', err);
    } finally {
      busy = false;
    }
  };
  renderMermaid();
  new MutationObserver(() => renderMermaid()).observe(document.body, { childList: true, subtree: true });
</script>
