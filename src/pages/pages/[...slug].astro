---
import { render } from 'astro:content';
import PageLayout from '@/components/layouts/PageLayout.astro';
import CodeGroupEvent from '@/components/code-group-event';
import 'remark-block-containers/css';
import '@/assets/style/blog.css';

export async function getStaticPaths() {
  const { getCollection } = await import('astro:content');
  const pagesEntries = await getCollection('pages', ({ data }: { data: { draft?: boolean } }) => {
    return import.meta.env.DEV || data.draft !== true;
  });

  return pagesEntries.map((page) => ({
    params: { slug: page.id },
    props: page,
  }));
}

const page = Astro.props;
const { Content } = await render(page);
---

<PageLayout title={page.data.title} description={page.data.description} lang="en">
  <CodeGroupEvent client:only="react" />

  <div slot="header">
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-slate9 transition-colors hover:text-slate12 cursor-pointer mb-12">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
      Back
    </a>
  </div>

  <div class="blog-content">
    <div class="mb-12">
      <h1>{page.data.title}</h1>
    </div>
    <Content />
  </div>
</PageLayout>

<script src="//unpkg.com/heti/umd/heti-addon.min.js" is:inline></script>
<script>
  const heti = new Heti('.blog-content');
  heti.autoSpacing();
</script>
